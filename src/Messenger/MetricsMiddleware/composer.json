{
  "name": "mmo/sf-messenger-metrics-middleware",
  "description": "Provides a middleware for Symfony Messenger to collect performance metrics such as processing time and message counts for both sent and consumed messages.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Marcin Morawski",
      "email": "marcin@morawskim.pl"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.3",
    "symfony/messenger": "^7.0"
  },
  "require-dev": {
    "promphp/prometheus_client_php": "^2.0",
    "psr/container": "^2.0",
    "symfony/service-contracts": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "mmo\\sf\\Messenger\\MetricsMiddleware\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "mmo\\sf\\Messenger\\MetricsMiddlewareTest\\": "tests/"
    }
  }
}
